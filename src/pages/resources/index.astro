---
// /resources/ — the three section cards now pull their headline from the
// content collections instead of the hardcoded Elementor placeholders that
// marketing flagged (Staging Review, slide 9). Those read:
//
//   BLOG                  "How Synthetix Modernized Banking Infrastructure in 12 Weeks"  (a case study title)
//   CASE STUDY            "Synthetix Modernized Infrastructure in 6 Weeks"               (matched nothing)
//   PRODUCT DOCUMENTATION "why Synthetixs  Modernized Banking Infrastructure."           (typo, matched nothing)
//
// Pulling from the collections means these stay correct when marketing
// publishes, rather than needing a code change every time.
import { getCollection } from 'astro:content';
import head from '../../layouts/shell/resources-head.html?raw';
import seg0 from '../../layouts/shell/resources-0.html?raw';
import seg1 from '../../layouts/shell/resources-1.html?raw';
import seg2 from '../../layouts/shell/resources-2.html?raw';
import seg3 from '../../layouts/shell/resources-3.html?raw';

const newest = async (name) => {
  const items = (await getCollection(name, ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return items[0]?.data.title ?? '';
};

const [article, caseStudy, agentDoc] = await Promise.all([
  newest('articles'),
  newest('case-studies'),
  newest('agent-docs'),
]);
---
<!DOCTYPE html>
<html lang="en-US">
<head>
	<meta charset="UTF-8" />
	<title>Resources &#8211; Synthetix Labs</title>
	<link rel="canonical" href="https://synthetixlabs.ai/resources/" />
	<Fragment set:html={head} />
</head>
<body class="wp-singular page-template-default page page-id-2096 page-parent wp-embed-responsive wp-theme-agenio angie-default ehf-header ehf-footer ehf-template-agenio ehf-stylesheet-agenio ally-default home-bg main-home onepage overflow-x-visible elementor-default elementor-kit-7 elementor-page elementor-page-2096">
<Fragment set:html={seg0} />{article}<Fragment set:html={seg1} />{caseStudy}<Fragment set:html={seg2} />{agentDoc}<Fragment set:html={seg3} />
</body>
</html>
